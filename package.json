{
  "name": "apexworkspace",
  "version": "1.0.14",
  "description": "Apex Workspace Matrix OS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --mac",
    "publish": "electron-builder build --mac -p always"
  },
  "dependencies": {
    "electron-notification-shim": "^1.0.0" 
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.apex.workspace",
    "productName": "ApexWorkspace",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "LegendaryKiddGamer",
      "repo": "apexworkspace"
    }
  }
}
