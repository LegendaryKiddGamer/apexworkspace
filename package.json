{
  "name": "apexworkspace",
  "version": "1.0.19",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.legendarykiddgamer.apexworkspace",
    "productName": "ApexWorkspace",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LegendaryKiddGamer",
        "repo": "apexworkspace"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    }
  }
}
